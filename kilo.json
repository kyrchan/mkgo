{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "kilo/poolside/laguna-s-2.1:free",
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "task": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "external_directory": "allow",
    "question": "deny"
  },
  "compaction": {
    "auto": true,
    "prune": true
  }
}

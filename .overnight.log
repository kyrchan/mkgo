{"type":"tool_use","timestamp":1787344962314,"sessionID":"ses_fda1daed3ffeZ76o2z0rrfeMgg","part":{"type":"tool","tool":"write","callID":"call_61481a190e9b4326b0600632","state":{"status":"completed","input":{"content":"/* Mini-WASI preview1 profile (AGENTS.md rule 4, frozen):\n *   fd_write proc_exit clock_time_get random_get args_get args_sizes_get\n *   environ_get environ_sizes_get sched_yield\n * Everything else in the namespace gets a conservative ENOSYS stub so\n * stock toolchain runtimes (Go) still LINK; the behavioral surface stays\n * the frozen set. Decision recorded: stubs never touch HW/FS state. */\n#include \"wasi_glue.h\"\n#include \"plat.h\"\n#include \"rt.h\"\n\nextern \"C\" {\n#include \"m3_api_defs.h\"\n#include \"m3_core.h\"\n}\n\n/* ---- session context the glue operates on ---- */\nstatic const char *g_args[] = {\"app\"};\nstatic char g_argbuf[64];\nstatic uint32_t g_argbuf_len;\nstatic const char *g_env[] = {0};\nstatic bool g_exited;\nstatic int g_exit_code;\n\nbool wasi_exited(void) { return g_exited; }\nint wasi_exit_code(void) { return g_exit_code; }\nvoid wasi_reset_session(void) {\n    g_exited = false;\n    g_exit_code = 0;\n    g_args[0] = \"app\";\n    g_env[0] = 0;\n}\n\nvoid wasi_set_argv(const char *const *argv, int argc) {\n    static char buf[256];\n    uint32_t off = 0;\n    for (int i = 0; i < argc && i < 16; i++) {\n        g_args[i] = argv[i];\n        off += (uint32_t)(strlen(argv[i]) + 1);\n    }\n    if (off < sizeof(buf))\n        g_argbuf_len = off;\n    g_args[argc ? argc : 1] = 0;\n    (void)g_argbuf;\n    (void)buf;\n}\n\n/* errno values (preview1) */\n#define WASI_EINVAL 28\n#define WASI_ENOSYS 52\n#define WASI_ESUCCESS 0\n\n/* TSC-based ns clock, calibrated once by arch timer (khz from PIT). */\nstatic uint64_t g_tsc_khz = 2000000; /* sane default until calibrated */\nvoid wasi_calibrate_clock(uint64_t tsc_khz) {\n    if (tsc_khz)\n        g_tsc_khz = tsc_khz;\n}\nuint64_t wasi_now_ns(void) {\n    return cpu_cycles() / g_tsc_khz * 1000000ULL;\n}\n\n/* ---- PRNG (xorshift64*, seeded from cycles) ---- */\nstatic uint64_t g_rng = 0x9E3779B97F4A7C15ULL;\nstatic uint64_t rng_next(void) {\n    if (!cpu_cycles())\n        g_rng ^= 1;\n    g_rng ^= cpu_cycles() & 1;\n    g_rng ^= g_rng << 13;\n    g_rng ^= g_rng >> 7;\n    g_rng ^= g_rng << 17;\n    return g_rng * 0x2545F4914F6CDD1DULL;\n}\n\nm3ApiRawFunction(wasi_fd_write) {\n    m3ApiReturnType(int32_t)\n    m3ApiGetArg(int32_t, fd)\n    m3ApiGetArgMem(uint32_t *, iovs)\n    m3ApiGetArg(int32_t, iovs_len)\n    m3ApiGetArgMem(uint32_t *, nwritten)\n    if (fd != 1 && fd != 2)\n        m3ApiReturn(WASI_EINVAL);\n    uint32_t total = 0;\n    for (int32_t i = 0; i < iovs_len; i++) {\n        /* iovec = {ptr u32, len u32} inside guest memory */\n        uint8_t *iovbase = (uint8_t *)iovs + (uint64_t)i * 8;\n        uint32_t ptr = *(uint32_t *)(iovbase);\n        uint32_t len = *(uint32_t *)(iovbase + 4);\n        uint8_t *data = m3ApiOffsetToPtr(ptr); /* guest-mem pointer */\n        for (uint32_t j = 0; j < len; j++)\n            console_putc((char)data[j]);\n        total += len;\n    }\n    if (nwritten)\n        *nwritten = total;\n    m3ApiReturn(WASI_ESUCCESS);\n}\n\nm3ApiRawFunction(wasi_proc_exit) {\n    m3ApiGetArg(int32_t, code)\n    g_exit_code = code;\n    g_exited = true;\n    m3ApiReturn(WASI_ESUCCESS);\n}\n\nm3ApiRawFunction(wasi_clock_time_get) {\n    m3ApiReturnType(int32_t)\n    m3ApiGetArg(int32_t, clock_id)\n    m3ApiGetArg(int64_t, precision)\n    m3ApiGetArgMem(uint64_t *, time)\n    (void)precision;\n    if (clock_id != 0 /*realtime*/ && clock_id != 1 /*monotonic*/)\n        m3ApiReturn(WASI_EINVAL);\n    if (time)\n        *time = wasi_now_ns();\n    m3ApiReturn(WASI_ESUCCESS);\n}\n\nm3ApiRawFunction(wasi_random_get) {\n    m3ApiReturnType(int32_t)\n    m3ApiGetArgMem(uint8_t *, buf)\n    m3ApiGetArg(int32_t, len)\n    for (int32_t i = 0; i < len; i++) {\n        buf[i] = (uint8_t)rng_next();\n    }\n    m3ApiReturn(WASI_ESUCCESS);\n}\n\nm3ApiRawFunction(wasi_args_sizes_get) {\n    m3ApiReturnType(int32_t)\n    m3ApiGetArgMem(uint32_t *, retptr0) /* argc */\n    m3ApiGetArgMem(uint32_t *, retptr1) /* argv_buf_size */\n    uint32_t argc = 0, bufsize = 0;\n    while (g_args[argc]) {\n        bufsize += (uint32_t)(strlen(g_args[argc]) + 1);\n        argc++;\n    }\n    if (retptr0)\n        *retptr0 = argc;\n    if (retptr1)\n        *retptr1 = bufsize;\n    m3ApiReturn(WASI_ESUCCESS);\n}\n\nm3ApiRawFunction(wasi_args_get) {\n    m3ApiReturnType(int32_t)\n    m3ApiGetArgMem(uint32_t *, argv)\n    m3ApiGetArgMem(uint8_t *, argv_buf)\n    uint32_t argc = 0;\n    uint64_t off = 0;\n    while (g_args[argc]) {\n        argv[argc] = (uint32_t)((uint8_t *)argv_buf - m3ApiGetBasePtr() + off);\n        const char *s = g_args[argc];\n        for (uint64_t k = 0; k <= strlen(s); k++)\n            argv_buf[off + k] = s[k];\n        off += strlen(s) + 1;\n        argc++;\n    }\n    m3ApiReturn(WASI_ESUCCESS);\n}\n\nm3ApiRawFunction(wasi_environ_sizes_get) {\n    m3ApiReturnType(int32_t)\n    m3ApiGetArgMem(uint32_t *, retptr0)\n    m3ApiGetArgMem(uint32_t *, retptr1)\n    if (retptr0)\n        *retptr0 = 0;\n    if (retptr1)\n        *retptr1 = 0;\n    m3ApiReturn(WASI_ESUCCESS);\n}\n\nm3ApiRawFunction(wasi_environ_get) {\n    m3ApiReturnType(int32_t)\n    m3ApiGetArgMem(uint32_t *, environ UNUSED)\n    m3ApiGetArgMem(uint8_t *, buf UNUSED)\n    m3ApiReturn(WASI_ESUCCESS);\n}\n\nm3ApiRawFunction(wasi_sched_yield) {\n    m3ApiReturnType(int32_t)\n    m3ApiReturn(WASI_ESUCCESS); /* cooperative no-op: single session */\n}\n\n/* ---- conservative linkage stubs (ENOSYS), see header comment ---- */\n\n#define STUB2(name)                                                            \\\n    m3ApiRawFunction(name) { m3ApiReturnType(int32_t) m3ApiReturn(WASI_ENOSYS); }\n\nSTUB2(stub_i_iiii)\n","filePath":"/home/cyr/kernel/core/wasi_glue.cc"},"output":"Wrote file successfully.","metadata":{"diagnostics
signed);\n\n    sched_init();\n    ports_init();\n\n    uint64_t cl, ll, fl, al, bl;\n    uint8_t *c = slurp(argv[1], &cl);\n    uint8_t *l = slurp(argv[2], &ll);\n    uint8_t *f = slurp(argv[3], &fl);\n    uint8_t *a = slurp(argv[4], &al);\n    uint8_t *b = slurp(argv[5], &bl);\n\n    int sfs = sched_spawn_named(\"fs\", f, fl, 0, 0);\n    if (sfs > 0)\n        devblk_attach((unsigned)sfs);\n    sched_spawn_named(\"console\", c, cl, 0, 0);\n    sched_spawn_named(\"login\", l, ll, 0, 0);\n    sched_spawn_named(\"ppa\", a, al, 0, 0x1 | 0x2 | 0x4 | 0x40);\n    sched_spawn_named(\"ppb\", b, bl, 0, 0);\n    sched_run();\n    fprintf(stderr, \"[host] scheduler drained\\\\n\");\n    return 0;\n}''')\nopen(p,'w').write(s)\nprint('ok')\nPYEOF\ng++ -std=c++20 -O1 -g -DNDEBUG -DHOST_BUILD -Icore -Iarch/x86_64 -Ithird_party/wasm3 -o /tmp/opencode/hostp5 tools/hostp4.cc /tmp/opencode/hoststubs.cc core/engine.cc core/sched.cc core/ports.cc core/kernsvc.cc core/ctx.cc core/devblk.cc core/wasi_glue.cc core/rt.cc core/lib.cc /tmp/opencode/w3c/*.o /tmp/opencode/ctx_host.o 2>&1 | grep -E 'error' | head -5","timeout":300000,"workdir":"/home/cyr/kernel"},"output":"ok\ncollect2: error: ld returned 1 exit status\n","metadata":{"output":"ok\ncollect2: error: ld returned 1 exit status\n","exit":0,"truncated":false},"title":"python3 <<'PYEOF'\np='tools/hostp4.cc'; s=open(p).read()\ns=s.replace('''int main(int argc, char **argv) {\n    if (argc != 5) {\n        fprintf(stderr, \"usage: hostp4 console.wasm login.wasm app.wasm app2.wasm\\\\n\");\n        return 2;\n    }\n    extern void wasi_calibrate_clock(uint64_t);\n    wasi_calibrate_clock(timer_calibrate_tsc_khz());\n\n    extern void sched_init(void);\n    extern void ports_init(void);\n    extern void sched_run(void);\n    extern int sched_spawn_named(const char *, const uint8_t *, uint64_t,\n                                 uint32_t, uint64_t);\n\n    sched_init();\n    ports_init();\n\n    uint64_t cl, ll, al, bl;\n    uint8_t *c = sl
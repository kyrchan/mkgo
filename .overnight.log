; load_esp_file overrides per call */\nstatic const CHAR16 *g_path;\nstatic CHAR16 def_path[] = {'v','m','\\\\\\\\','a','p','p',0};''')\nold='''int load_esp_file(EFI_HANDLE image_handle, EFI_SYSTEM_TABLE *st,\n                  const CHAR16 *path, void **out, uint64_t *out_len) {\n    CHAR16 saved[64];\n    int i = 0;\n    for (; i < 62 && prog_path[i]; i++)\n        saved[i] = prog_path[i];\n    saved[i] = 0;\n    int j = 0;\n    for (; j < 62 && path[j]; j++)\n        prog_path[j] = path[j];\n    prog_path[j] = 0;\n    int rc = load_program(image_handle, st, out, out_len);\n    for (int k = 0; k <= i; k++)\n        prog_path[k] = saved[k];\n    return rc;\n}\n\nint load_program(EFI_HANDLE image_handle, EFI_SYSTEM_TABLE *st,\n                 void **out, uint64_t *out_len) {'''\nnew='''int load_esp_file(EFI_HANDLE image_handle, EFI_SYSTEM_TABLE *st,\n                  const CHAR16 *path, void **out, uint64_t *out_len) {\n    g_path = path;\n    return load_program(image_handle, st, out, out_len);\n}\n\nint load_program(EFI_HANDLE image_handle, EFI_SYSTEM_TABLE *st,\n                 void **out, uint64_t *out_len) {\n    if (!g_path)\n        g_path = def_path;'''\nassert old in s; s=s.replace(old,new)\n# replace uses of prog_path inside load_program with g_path\nimport re\nhead, sep, tail = s.partition('int load_program(')\ntail = tail.replace('prog_path', 'g_path')\ns = head + sep + tail\nopen(p,'w').write(s)\nprint(open(p).read()[:900])\nEOF","time":{"start":1787351969658,"end":1787351969663}},"id":"prt_0267aaf2e0013ZdzuA63nCHofR","sessionID":"ses_fda1daed3ffeZ76o2z0rrfeMgg","messageID":"msg_0267a5f080014JXSV02tsobfWy"}}

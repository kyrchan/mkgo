7 2>&1 | grep -aE 'TEST PASS|TEST FAIL|Welcome' | head -3","timeout":900000},"output":"ok\nno required module provides package main_wasm.go; to add it:\n\tgo get main_wasm.go\nno required module provides package fscore.go; to add it:\n\tgo get fscore.go\n","metadata":{"output":"ok\nno required module provides package main_wasm.go; to add it:\n\tgo get main_wasm.go\nno required module provides package fscore.go; to add it:\n\tgo get fscore.go\n","exit":1,"truncated":false},"title":"python3 <<'PYEOF'\np='/home/cyr/kernel/core/devblk.h'; s=open(p).read()\ns=s.replace('int  devblk_attach(uint32_t sid); /* give sid a block window; 0 ok */','int  devblk_attach(void); /* allocate backend; 0 ok */')\nopen(p,'w').write(s)\n\np='/home/cyr/kernel/core/devblk.cc'; s=open(p).read()\ns=s.replace('''int devblk_attach(uint32_t sid) {\n    if (dev.used)\n        return -1;\n    if (!dev.disk) {''','''int devblk_attach(void) {\n    if (dev.used)\n        return 0; /* idempotent */\n    if (!dev.disk) {''')\ns=s.replace('''    dev.used = true;\n    dev.sid = sid;\n    console_puts(\"[devblk] ramdisk ready sid=\");\n    console_hex64(sid);\n    console_puts(\" blocks=\");''','''    dev.used = true;\n    console_puts(\"[devblk] ramdisk ready blocks=\");''')\nopen(p,'w').write(s)\n\np='/home/cyr/kernel/core/kmain.cc'; s=open(p).read()\nold='''    devblk_init();\n    if (bi->mod_fs && bi->mod_fs_len) {\n        /* fs owns the block device; attach before anything runs */\n        int sfs = sched_spawn_named(\"fs\", (const uint8_t *)(uintptr_t)bi->mod_fs,\n                                    bi->mod_fs_len, 0, 0);\n        if (sfs > 0)\n            devblk_attach((uint32_t)sfs);\n    }\n'''\nnew='''    devblk_init();\n    devblk_attach();\n'''\nassert old in s; s=s.replace(old,new)\n# move devblk_init/attach BEFORE sched_init? fine after; ensure order: keep where placed\nopen(p,'w').write(s)\n\n# init spawns fs via conf already; make sure kmain's own fs preload remains for SPAWN table ✓ (kep
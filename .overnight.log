{"type":"tool_use","timestamp":1787342938928,"sessionID":"ses_fda1daed3ffeZ76o2z0rrfeMgg","part":{"type":"tool","tool":"read","callID":"call_d6e9fb4d9fa245349671df79","state":{"status":"completed","input":{"filePath":"/home/cyr/kernel/tools/vasm/main.go"},"output":"<path>/home/cyr/kernel/tools/vasm/main.go</path>\n<type>file</type>\n<content>\n1: // vasm: assembler for the kernel's restricted ISA (see kernel/vm/isa.h).\n2: //\n3: // Usage: vasm input.vasm output.vbin\n4: //\n5: // Syntax:\n6: //   .text | .data            switch section\n7: //   label:                   define label in current section\n8: //   mov r1, 42               imm -> reg\n9: //   mov r1, r2               reg -> reg\n10: //   mov r1, [r2+8]           mem -> reg\n11: //   mov [r2+8], r1           reg -> mem\n12: //   lea r1, [r2+16]          r1 = r2 + 16   ([sym] == [r0+symoff])\n13: //   sub r1, r2 | sub r1, 10  sets ZF\n14: //   jz label                 branch if ZF\n15: //   vmovdqu v1, [r2+32]      load 256 bits\n16: //   vmovdqu [r2+32], v1      store 256 bits\n17: //   vpbroadcast.q v1, r6     broadcast scalar (.b/.w/.d/.q)\n18: //   vpsub.q v4, v2, v3       v4 = v2 - v3 (lanewise)\n19: //   vpcmpeq.q v7, v5, v6     v7 = lane mask; ZF = all lanes equal\n20: //   halt                     stop the machine\n21: package main\n22: \n23: import (\n24: \t\"encoding/binary\"\n25: \t\"fmt\"\n26: \t\"os\"\n27: \t\"strconv\"\n28: \t\"strings\"\n29: )\n30: \n31: type insn struct {\n32: \top, dst, src, aux byte\n33: \timm               uint64\n34: }\n35: \n36: type prog struct {\n37: \ttext []insn\n38: \tdata []byte\n39: \tlabels map[string]label\n40: }\n41: \n42: type label struct {\n43: \tsection string // \"text\" or \"data\"\n44: \toffset  uint64\n45: }\n46: \n47: func main() {\n48: \tif len(os.Args) != 3 {\n49: \t\tfmt.Fprintln(os.Stderr, \"usage: vasm in.vasm out.vbin\")\n50: \t\tos.Exit(2)\n51: \t}\n52: \tsrc, err := os.ReadFile(os.Args[1])\n53: \tcheck(err)\n54: \tp := assemble(string(src))\n55: \tcheck(os.WriteFile(os.Args[2], p.emit(), 0o644))\n56: }\n57: \n58: func check(err error) {\n59: \tif err != nil {\n60: \t\tfmt.Fprintln(os.Stderr, \"vasm:\", err)\n61: \t\tos.Exit(1)\n62: \t}\n63: }\n64: \n65: func assemble(src string) *prog {\n66: \tp := &prog{labels: map[string]label{}}\n67: \ttype pending struct {\n68: \t\tmnemonic string\n69: \t\tops      []string\n70: \t\tline     int\n71: \t}\n72: \tvar pend []pending\n73: \n74: \tsection := \"text\"\n75: \tfor ln, raw := range strings.Split(src, \"\\n\") {\n76: \t\tline := strings.TrimSpace(raw)\n77: \t\tif i := strings.Index(line, \";\"); i >= 0 {\n78: \t\t\tline = strings.TrimSpace(line[:i])\n79: \t\t}\n80: \t\tif line == \"\" {\n81: \t\t\tcontinue\n82: \t\t}\n83: \t\t// peel off any leading \"name:\" labels\n84: \t\tfor {\n85: \t\t\tcol := strings.Index(line, \":\")\n86: \t\t\tif col < 0 || strings.Contains(line[:col], \" \") ||\n87: \t\t\t\tstrings.Contains(line[:col], \"[\") {\n88: \t\t\t\tbreak\n89: \t\t\t}\n90: \t\t\tname := line[:col]\n91: \t\t\tvar off uint64\n92: \t\t\tif section == \"text\" {\n93: \t\t\t\toff = uint64(len(p.text)) * 16\n94: \t\t\t} else {\n95: \t\t\t\toff = uint64(len(p.data))\n96: \t\t\t}\n97: \t\t\tp.labels[name] = label{section, off}\n98: \t\t\tline = strings.TrimSpace(line[col+1:])\n99: \t\t}\n100: \t\tif line == \"\" {\n101: \t\t\tcontinue\n102: \t\t}\n103: \t\tswitch {\n104: \t\tcase line == \".text\":\n105: \t\t\tsection = \"text\"\n106: \t\t\tcontinue\n107: \t\tcase line == \".data\":\n108: \t\t\tsection = \"data\"\n109: \t\t\tcontinue\n110: \t\tcase strings.HasPrefix(line, \".space\"):\n111: \t\t\tf := strings.Fields(line)\n112: \t\t\tn, _ := strconv.Atoi(f[1])\n113: \t\t\tp.data = append(p.data, make([]byte, n)...)\n114: \t\t\tcontinue\n115: \t\tcase strings.HasPrefix(line, \".int\"):\n116: \t\t\tfor _, f := range strings.Fields(line)[1:] {\n117: \t\t\t\tv, _ := parseNum(f)\n118: \t\t\t\tvar b [8]byte\n119: \t\t\t\tbinary.LittleEndian.PutUint64(b[:], v)\n120: \t\t\t\tp.data = append(p.data, b[:]...)\n121: \t\t\t}\n122: \t\t\tcontinue\n123: \t\tcase strings.HasPrefix(line, \".byte\"):\n124: \t\t\tfor _, f := range strings.Fields(line)[1:] {\n125: \t\t\t\tv, _ := parseNum(f)\n126: \t\t\t\tp.data = append(p.data, byte(v))\n127: \t\t\t}\n128: \t\t\tcontinue\n129: \t\t}\n130: \t\tf := strings.Fields(line)\n131: \t\tmn := f[0]\n132: \t\trest := \"\"\n133: \t\tif len(f) > 1 {\n134: \t\t\trest = strings.Join(f[1:], \"\")\n135: \t\t}\n136: \t\tops := splitOps(rest)\n137: \t\tif mn != \"halt\" && len(ops) == 0 {\n138: \t\t\tfail(ln, \"missing operands\")\n139: \t\t}\n140: \t\tpend = append(pend, pending{mn, ops, ln})\n141: \t}\n142: \n143: \t// pass 2: encode with labels resolved\n144: \tfor _, pd := range pend {\n145: \t\tin := p.encode(pd.mnemonic, pd.ops, pd.line)\n146: \t\tp.text = append(p.text, in)\n147: \t}\n148: \treturn p\n149: }\n150: \n151: func fail(line int, msg string) {\n152: \tcheck(fmt.Errorf(\"line %d: %s\", line+1, msg))\n153: }\n154: \n155: func splitOps(s string) []string {\n156: \tif s == \"\" {\n157: \t\treturn nil\n158: \t}\n159: \tvar out []string\n160: \tdepth := 0\n161: \tcur := strings.Builder{}\n162: \tfor _, r := range s {\n163: \t\tswitch r {\n164: \t\tcase '[':\n165: \t\t\tdepth++\n166: \t\tcase ']':\n167: \t\t\tdepth--\n168: \t\tcase ',':\n169: \t\t\tif depth == 0 {\n170: \t\t\t\tout = append(out, cur.String())\n171: \t\t\t\tcur.Reset()\n172: \t\t\t\tcontinue\n173: \t\t\t}\n174: \t\t}\n175: \t\tcur.WriteRune(r)\n176: \t}\n177: \tout = append(out, cur.String())\n178: \treturn out\n179: }\n180: \n181: func parseNum(s string) (uint64, error) {\n182: \ts = strings.TrimSpace(s)\n183: \tif len(s) >= 3 && s[0] == '\\'' && s[len(s)-1] == '\\'' {\n184: \t\treturn uint64(s[1]), nil\n185: \t}\n186: \tif strings.HasPrefix(s, \"0x\") || strings.HasPrefix(s, \"0X\") {\n187: \t\treturn strconv.ParseUint(s[2:], 16, 64)\n188: \t}\n189: \treturn strconv.ParseUint(s, 10, 64)\n190: }\n191: \n192: func isReg(s string) bool  { return len(s) >= 2 && s[0] == 'r' }\n193: func isVec(s string) bool  { return len(s) >= 2 && s[0] == 'v' }\n194: func regNum(s string) byte { n, _ := strconv.Atoi(s[1:]); return byte(n) }\n195: \n196: // mem parses \"[expr]\" where expr = reg | reg+N | sym | sym+N.\n197: func mem(s string) (base byte, disp uint64, sym string, ok bool) {\n198: \tif !strings.HasPrefix(s, \"[\") || !strings.HasSuffix(s, \"]\") {\n199: \t\treturn\n200: \t}\n201: \tok = true\n202: \te := s[1 : len(s)-1]\n203: \tif i := strings.Index(e, \"+\"); i >= 0 {\n204: \t\tsymPart, offPart := e[:i], e[i+1:]\n205: \t\tif isReg(symPart) {\n206: \t\t\tbase = regNum(symPart)\n207: \t\t} else {\n208: \t\t\tsym = symPart\n209: \t\t}\n210: \t\tdisp, _ = parseNum(offPart)\n211: \t\treturn\n212: \t}\n213: \tif isReg(e) {\n214: \t\tbase = regNum(e)\n215: \t\treturn\n216: \t}\n217: \tsym = e\n218: \treturn\n219: }\n220: \n221: func sizeClass(suffix string) (byte, bool) {\n222: \tswitch suffix {\n223: \tcase \".b\":\n224: \t\treturn 0, true\n225: \tcase \".w\":\n226: \t\treturn 1, true\n227: \tcase \".d\":\n228: \t\treturn 2, true\n229: \tcase \".q\", \"\":\n230: \t\treturn 3, true\n231: \t}\n232: \treturn 0, false\n233: }\n234: \n235: func (p *prog) resolve(op string) uint64 {\n236: \tl, ok := p.labels[op]\n237: \tif !ok {\n238: \t\tcheck(fmt.Errorf(\"undefined symbol %q\", op))\n239: \t}\n240: \treturn l.offset\n241: }\n242: \n243: func (p *prog) memEA(o string, line int) (base byte, disp uint64) {\n244: \tb, d, sym, ok := mem(o)\n245: \tif !ok {\n246: \t\tfail(line, \"bad memory operand \"+o)\n247: \t}\n248: \tif sym != \"\" {\n249: \t\td += p.resolve(sym)\n250: \t}\n251: \treturn b, d\n252: }\n253: \n254: func (p *prog) encode(mn string, ops []string, line int) insn {\n255: \tin := insn{}\n256: \tswitch mn {\n257: \tcase \"mov\":\n258: \t\tin.op = 1\n259: \t\tdst, src := ops[0], ops[1]\n260: \t\tif strings.HasPrefix(dst, \"[\") {\n261: \t\t\t// reg -> mem; optional width suffix on mnemonic handled below\n262: \t\t\tin.aux = 3 | (3 << 4) // mode 3, width q by default\n263: \t\t\tb, d := p.memEA(dst, line)\n264: \t\t\tin.dst, in.src, in.imm = b, regNum(src), d\n265: \t\t\treturn in\n266: \t\t}\n267: \t\tif strings.HasPrefix(src, \"[\") {\n268: \t\t\tin.aux = 2 | (3 << 4) // mem -> reg\n269: \t\t\tb, d := p.memEA(src, line)\n270: \t\t\tin.dst, in.src, in.imm = regNum(dst), b, d\n271: \t\t\treturn in\n272: \t\t}\n273: \t\tif isReg(src) {\n274: \t\t\tin.aux = 1\n275: \t\t\tin.dst, in.src = regNum(dst), regNum(src)\n276: \t\t\treturn in\n277: \t\t}\n278: \t\tv, _ := parseNum(src)\n279: \t\tin.aux = 0\n280: \t\tin.dst, in.imm = regNum(dst), v\n281: \t\treturn in\n282: \n283: \tcase \"lea\":\n284: \t\tin.op = 2\n285: \t\tb, d := p.memEA(ops[1], line)\n286: \t\tin.dst, in.src, in.imm = regNum(ops[0]), b, d\n287: \t\treturn in\n288: \n289: \tcase \"sub\":\n290: \t\tin.op = 3\n291: \t\tif isReg(ops[1]) {\n292: \t\t\tin.aux = 1\n293: \t\t\tin.dst, in.src = regNum(ops[0]), regNum(ops[1])\n294: \t\t} else {\n295: \t\t\tin.aux = 0\n296: \t\t\tin.dst, _ = regNum(ops[0]), 0\n297: \t\t\tin.imm, _ = parseNum(ops[1])\n298: \t\t}\n299: \t\treturn in\n300: \n301: \tcase \"jz\":\n302: \t\tin.op = 4\n303: \t\tin.imm = p.resolve(ops[0])\n304: \t\treturn in\n305: \n306: \tcase \"vmovdqu\":\n307: \t\tin.op = 5\n308: \t\tif strings.HasPrefix(ops[0], \"[\") { // store\n309: \t\t\tin.aux = 0x80\n310: \t\t\tb, d := p.memEA(ops[0], line)\n311: \t\t\tin.dst, in.src, in.imm = regNum(ops[1]), b, d\n312: \t\t\treturn in\n313: \t\t}\n314: \t\tb, d := p.memEA(ops[1], line) // load\n315: \t\tin.dst, in.src, in.imm = regNum(ops[0]), b, d\n316: \t\treturn in\n317: \n318: \tcase \"vpbroadcast\", \"vpbroadcast.b\", \"vpbroadcast.w\", \"vpbroadcast.d\", \"vpbroadcast.q\":\n319: \t\tcls, _ := sizeClass(strings.TrimPrefix(mn, \"vpbroadcast\"))\n320: \t\tin.op = 6\n321: \t\tin.aux = cls\n322: \t\tin.dst = regNum(ops[0])\n323: \t\tin.src = regNum(ops[1])\n324: \t\treturn in\n325: \n326: \tcase \"vpsub\", \"vpsub.b\", \"vpsub.w\", \"vpsub.d\", \"vpsub.q\",\n327: \t\t\"vpcmpeq\", \"vpcmpeq.b\", \"vpcmpeq.w\", \"vpcmpeq.d\", \"vpcmpeq.q\":\n328: \t\tcls, _ := sizeClass(suffixOf(mn))\n329: \t\tin.op = 7\n330: \t\tif strings.HasPrefix(mn, \"vpcmpeq\") {\n331: \t\t\tin.op = 8\n332: \t\t}\n333: \t\tin.aux = cls | regNum(ops[2])<<4\n334: \t\tin.dst, in.src = regNum(ops[0]), regNum(ops[1])\n335: \t\treturn in\n336: \n337: \tcase \"halt\":\n338: \t\tin.op = 0xFF\n339: \t\treturn in\n340: \t}\n341: \tfail(line, \"unknown instruction \"+mn)\n342: \treturn in\n343: }\n344: \n345: func suffixOf(s string) string {\n346: \tif i := strings.Index(s, \".\"); i >= 0 {\n347: \t\treturn s[i:]\n348: \t}\n349: \treturn \"\"\n350: }\n351: \n352: func max(a, b int) int {\n353: \tif a > b {\n354: \t\treturn a\n355: \t}\n356: \treturn b\n357: }\n358: \n359: func (p *prog) emit() []byte {\n360: \thdrLen := 32\n361: \tcodeLen := len(p.text) * 16\n362: \tentry := uint64(0)\n363: \tif l, ok := p.labels[\"start\"]; ok && l.section == \"text\" {\n364: \t\tentry = l.offset\n365: \t}\n366: \tout := make([]byte, hdrLen+codeLen+len(p.data))\n367: \tcopy(out[0:4], \"VBIN\")\n368: \tbinary.LittleEndian.PutUint32(out[4:], 1)\n369: \tbinary.LittleEndian.PutUint32(out[8:], uint32(entry))\n370: \tbinary.LittleEndian.PutUint32(out[12:], uint32(hdrLen))\n371: \tbinary.LittleEndian.PutUint32(out[16:], uint32(codeLen))\n372: \tbinary.LittleEndian.PutUint32(out[20:], uint32(hdrLen+codeLen))\n373: \tbinary.LittleEndian.PutUint32(out[24:], uint32(len(p.data)))\n374: \tfor i, in := range p.text {\n375: \t\to := hdrLen + i*16\n376: \t\tout[o] = in.op\n377: \t\tout[o+1] = in.dst\n378: \t\tout[o+2] = in.src\n379: \t\tout[o+3] = in.aux\n380: \t\tbinary.LittleEndian.PutUint64(out[o+8:], in.imm)\n381: \t}\n382: \tcopy(out[hdrLen+codeLen:], p.data)\n383: \treturn out\n384: }\n\n(End of file - total 384 lines)\n</content>","metadata":{"preview":"// vasm: assembler for the kernel's restricted ISA (see kernel/vm/isa.h).\n//\n// Usage: vasm input.vasm output.vbin\n//\n// Syntax:\n//   .text | .data            switch section\n//   label:                   define label in current section\n//   mov r1, 42               imm -> reg\n//   mov r1, r2               reg -> reg\n//   mov r1, [r2+8]           mem -> reg\n//   mov [r2+8], r1           reg -> mem\n//   lea r1, [r2+16]          r1 = r2 + 16   ([sym] == [r0+symoff])\n//   sub r1, r2 | sub r1, 10  sets ZF\n//   jz label                 branch if ZF\n//   vmovdqu v1, [r2+32]      load 256 bits\n//   vmovdqu [r2+32], v1      store 256 bits\n//   vpbroadcast.q v1, r6     broadcast scalar (.b/.w/.d/.q)\n//   vpsub.q v4, v2, v3       v4 = v2 - v3 (lanewise)\n//   vpcmpeq.q v7, v5, v6     v7 = lane mask; ZF = all lanes equal\n//   halt                     stop the machine","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/cyr/kernel/tools/vasm/main.go","text":"// vasm: assembler for the kernel's restricted ISA (see kernel/vm/isa.h).\n//\n// Usage: vasm input.vasm output.vbin\n//\n// Syntax:\n//   .text | .data            switch section\n//   label:                   define label in current section\n//   mov r1, 42               imm -> reg\n//   mov r1, r2               reg -> reg\n//   mov r1, [r2+8]           mem -> reg\n//   mov [r2+8], r1           reg -> mem\n//   lea r1, [r2+16]          r1 = r2 + 16   ([sym] == [r0+symoff])\n//   sub r1, r2 | sub r1, 10  sets ZF\n//   jz label                 branch if ZF\n//   vmovdqu v1, [r2+32]      load 256 bits\n//   vmovdqu [r2+32], v1      store 256 bits\n//   vpbroadcast.q v1, r6     broadcast scalar (.b/.w/.d/.q)\n//   vpsub.q v4, v2, v3       v4 = v2 - v3 (lanewise)\n//   vpcmpeq.q v7, v5, v6     v7 = lane mask; ZF = all lanes equal\n//   halt                     stop the machine\npackage main\n\nimport (\n\t\"encoding/binary\"\n\t\"fmt\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n)\n\ntype insn struct {\n\top, dst, src, aux byte\n\timm               uint64\n}\n\ntype prog struct {\n\ttext []insn\n\tdata []byte\n\tlabels map[string]label\n}\n\ntype label struct {\n\tsection string // \"text\" or \"data\"\n\toffset  uint64\n}\n\nfunc main() {\n\tif len(os.Args) != 3 {\n\t\tfmt.Fprintln(os.Stderr, \"usage: vasm in.vasm out.vbin\")\n\t\tos.Exit(2)\n\t}\n\tsrc, err := os.ReadFile(os.Args[1])\n\tcheck(err)\n\tp := assemble(string(src))\n\tcheck(os.WriteFile(os.Args[2], p.emit(), 0o644))\n}\n\nfunc check(err error) {\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, \"vasm:\", err)\n\t\tos.Exit(1)\n\t}\n}\n\nfunc assemble(src string) *prog {\n\tp := &prog{labels: map[string]label{}}\n\ttype pending struct {\n\t\tmnemonic string\n\t\tops      []string\n\t\tline     int\n\t}\n\tvar pend []pending\n\n\tsection := \"text\"\n\tfor ln, raw := range strings.Split(src, \"\\n\") {\n\t\tline := strings.TrimSpace(raw)\n\t\tif i := strings.Index(line, \";\"); i >= 0 {\n\t\t\tline = strings.TrimSpace(line[:i])\n\t\t}\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\t// peel off any leading \"name:\" labels\n\t\tfor {\n\t\t\tcol := strings.Index(line, \":\")\n\t\t\tif col < 0 || strings.Contains(line[:col], \" \") ||\n\t\t\t\tstrings.Contains(line[:col], \"[\") {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tname := line[:col]\n\t\t\tvar off uint64\n\t\t\tif section == \"text\" {\n\t\t\t\toff = uint64(len(p.text)) * 16\n\t\t\t} else {\n\t\t\t\toff = uint64(len(p.data))\n\t\t\t}\n\t\t\tp.labels[name] = label{section, off}\n\t\t\tline = strings.TrimSpace(line[col+1:])\n\t\t}\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tswitch {\n\t\tcase line == \".text\":\n\t\t\tsection = \"text\"\n\t\t\tcontinue\n\t\tcase line == \".data\":\n\t\t\tsection = \"data\"\n\t\t\tcontinue\n\t\tcase strings.HasPrefix(line, \".space\"):\n\t\t\tf := strings.Fields(line)\n\t\t\tn, _ := strconv.Atoi(f[1])\n\t\t\tp.data = append(p.data, make([]byte, n)...)\n\t\t\tcontinue\n\t\tcase strings.HasPrefix(line, \".int\"):\n\t\t\tfor _, f := range strings.Fields(line)[1:] {\n\t\t\t\tv, _ := parseNum(f)\n\t\t\t\tvar b [8]byte\n\t\t\t\tbinary.LittleEndian.PutUint64(b[:], v)\n\t\t\t\tp.data = append(p.data, b[:]...)\n\t\t\t}\n\t\t\tcontinue\n\t\tcase strings.HasPrefix(line, \".byte\"):\n\t\t\tfor _, f := range strings.Fields(line)[1:] {\n\t\t\t\tv, _ := parseNum(f)\n\t\t\t\tp.data = append(p.data, byte(v))\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tf := strings.Fields(line)\n\t\tmn := f[0]\n\t\trest := \"\"\n\t\tif len(f) > 1 {\n\t\t\trest = strings.Join(f[1:], \"\")\n\t\t}\n\t\tops := splitOps(rest)\n\t\tif mn != \"halt\" && len(ops) == 0 {\n\t\t\tfail(ln, \"missing operands\")\n\t\t}\n\t\tpend = append(pend, pending{mn, ops, ln})\n\t}\n\n\t// pass 2: encode with labels resolved\n\tfor _, pd := range pend {\n\t\tin := p.encode(pd.mnemonic, pd.ops, pd.line)\n\t\tp.text = append(p.text, in)\n\t}\n\treturn p\n}\n\nfunc fail(line int, msg string) {\n\tcheck(fmt.Errorf(\"line %d: %s\", line+1, msg))\n}\n\nfunc splitOps(s string) []string {\n\tif s == \"\" {\n\t\treturn nil\n\t}\n\tvar out []string\n\tdepth := 0\n\tcur := strings.Builder{}\n\tfor _, r := range s {\n\t\tswitch r {\n\t\tcase '[':\n\t\t\tdepth++\n\t\tcase ']':\n\t\t\tdepth--\n\t\tcase ',':\n\t\t\tif depth == 0 {\n\t\t\t\tout = append(out, cur.String())\n\t\t\t\tcur.Reset()\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tcur.WriteRune(r)\n\t}\n\tout = append(out, cur.String())\n\treturn out\n}\n\nfunc parseNum(s string) (uint64, error) {\n\ts = strings.TrimSpace(s)\n\tif len(s) >= 3 && s[0] == '\\'' && s[len(s)-1] == '\\'' {\n\t\treturn uint64(s[1]), nil\n\t}\n\tif strings.HasPrefix(s, \"0x\") || strings.HasPrefix(s, \"0X\") {\n\t\treturn strconv.ParseUint(s[2:], 16, 64)\n\t}\n\treturn strconv.ParseUint(s, 10, 64)\n}\n\nfunc isReg(s string) bool  { return len(s) >= 2 && s[0] == 'r' }\nfunc isVec(s string) bool  { return len(s) >= 2 && s[0] == 'v' }\nfunc regNum(s string) byte { n, _ := strconv.Atoi(s[1:]); return byte(n) }\n\n// mem parses \"[expr]\" where expr = reg | reg+N | sym | sym+N.\nfunc mem(s string) (base byte, disp uint64, sym string, ok bool) {\n\tif !strings.HasPrefix(s, \"[\") || !strings.HasSuffix(s, \"]\") {\n\t\treturn\n\t}\n\tok = true\n\te := s[1 : len(s)-1]\n\tif i := strings.Index(e, \"+\"); i >= 0 {\n\t\tsymPart, offPart := e[:i], e[i+1:]\n\t\tif isReg(symPart) {\n\t\t\tbase = regNum(symPart)\n\t\t} else {\n\t\t\tsym = symPart\n\t\t}\n\t\tdisp, _ = parseNum(offPart)\n\t\treturn\n\t}\n\tif isReg(e) {\n\t\tbase = regNum(e)\n\t\treturn\n\t}\n\tsym = e\n\treturn\n}\n\nfunc sizeClass(suffix string) (byte, bool) {\n\tswitch suffix {\n\tcase \".b\":\n\t\treturn 0, true\n\tcase \".w\":\n\t\treturn 1, true\n\tcase \".d\":\n\t\treturn 2, true\n\tcase \".q\", \"\":\n\t\treturn 3, true\n\t}\n\treturn 0, false\n}\n\nfunc (p *prog) resolve(op string) uint64 {\n\tl, ok := p.labels[op]\n\tif !ok {\n\t\tcheck(fmt.Errorf(\"undefined symbol %q\", op))\n\t}\n\treturn l.offset\n}\n\nfunc (p *prog) memEA(o string, line int) (base byte, disp uint64) {\n\tb, d, sym, ok := mem(o)\n\tif !ok {\n\t\tfail(line, \"bad memory operand \"+o)\n\t}\n\tif sym != \"\" {\n\t\td += p.resolve(sym)\n\t}\n\treturn b, d\n}\n\nfunc (p *prog) encode(mn string, ops []string, line int) insn {\n\tin := insn{}\n\tswitch mn {\n\tcase \"mov\":\n\t\tin.op = 1\n\t\tdst, src := ops[0], ops[1]\n\t\tif strings.HasPrefix(dst, \"[\") {\n\t\t\t// reg -> mem; optional width suffix on mnemonic handled below\n\t\t\tin.aux = 3 | (3 << 4) // mode 3, width q by default\n\t\t\tb, d := p.memEA(dst, line)\n\t\t\tin.dst, in.src, in.imm = b, regNum(src), d\n\t\t\treturn in\n\t\t}\n\t\tif strings.HasPrefix(src, \"[\") {\n\t\t\tin.aux = 2 | (3 << 4) // mem -> reg\n\t\t\tb, d := p.memEA(src, line)\n\t\t\tin.dst, in.src, in.imm = regNum(dst), b, d\n\t\t\treturn in\n\t\t}\n\t\tif isReg(src) {\n\t\t\tin.aux = 1\n\t\t\tin.dst, in.src = regNum(dst), regNum(src)\n\t\t\treturn in\n\t\t}\n\t\tv, _ := parseNum(src)\n\t\tin.aux = 0\n\t\tin.dst, in.imm = regNum(dst), v\n\t\treturn in\n\n\tcase \"lea\":\n\t\tin.op = 2\n\t\tb, d := p.memEA(ops[1], line)\n\t\tin.dst, in.src, in.imm = regNum(ops[0]), b, d\n\t\treturn in\n\n\tcase \"sub\":\n\t\tin.op = 3\n\t\tif isReg(ops[1]) {\n\t\t\tin.aux = 1\n\t\t\tin.dst, in.src = regNum(ops[0]), regNum(ops[1])\n\t\t} else {\n\t\t\tin.aux = 0\n\t\t\tin.dst, _ = regNum(ops[0]), 0\n\t\t\tin.imm, _ = parseNum(ops[1])\n\t\t}\n\t\treturn in\n\n\tcase \"jz\":\n\t\tin.op = 4\n\t\tin.imm = p.resolve(ops[0])\n\t\treturn in\n\n\tcase \"vmovdqu\":\n\t\tin.op = 5\n\t\tif strings.HasPrefix(ops[0], \"[\") { // store\n\t\t\tin.aux = 0x80\n\t\t\tb, d := p.memEA(ops[0], line)\n\t\t\tin.dst, in.src, in.imm = regNum(ops[1]), b, d\n\t\t\treturn in\n\t\t}\n\t\tb, d := p.memEA(ops[1], line) // load\n\t\tin.dst, in.src, in.imm = regNum(ops[0]), b, d\n\t\treturn in\n\n\tcase \"vpbroadcast\", \"vpbroadcast.b\", \"vpbroadcast.w\", \"vpbroadcast.d\", \"vpbroadcast.q\":\n\t\tcls, _ := sizeClass(strings.TrimPrefix(mn, \"vpbroadcast\"))\n\t\tin.op = 6\n\t\tin.aux = cls\n\t\tin.dst = regNum(ops[0])\n\t\tin.src = regNum(ops[1])\n\t\treturn in\n\n\tcase \"vpsub\", \"vpsub.b\", \"vpsub.w\", \"vpsub.d\", \"vpsub.q\",\n\t\t\"vpcmpeq\", \"vpcmpeq.b\", \"vpcmpeq.w\", \"vpcmpeq.d\", \"vpcmpeq.q\":\n\t\tcls, _ := sizeClass(suffixOf(mn))\n\t\tin.op = 7\n\t\tif strings.HasPrefix(mn, \"vpcmpeq\") {\n\t\t\tin.op = 8\n\t\t}\n\t\tin.aux = cls | regNum(ops[2])<<4\n\t\tin.dst, in.src = regNum(ops[0]), regNum(ops[1])\n\t\treturn in\n\n\tcase \"halt\":\n\t\tin.op = 0xFF\n\t\treturn in\n\t}\n\tfail(line, \"unknown instruction \"+mn)\n\treturn in\n}\n\nfunc suffixOf(s string) string {\n\tif i := strings.Index(s, \".\"); i >= 0 {\n\t\treturn s[i:]\n\t}\n\treturn \"\"\n}\n\nfunc max(a, b int) int {\n\tif a > b {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc (p *prog) emit() []byte {\n\thdrLen := 32\n\tcodeLen := len(p.text) * 16\n\tentry := uint64(0)\n\tif l, ok := p.labels[\"start\"]; ok && l.section == \"text\" {\n\t\tentry = l.offset\n\t}\n\tout := make([]byte, hdrLen+codeLen+len(p.data))\n\tcopy(out[0:4], \"VBIN\")\n\tbinary.LittleEndian.PutUint32(out[4:], 1)\n\tbinary.LittleEndian.PutUint32(out[8:], uint32(entry))\n\tbinary.LittleEndian.PutUint32(out[12:], uint32(hdrLen))\n\tbinary.LittleEndian.PutUint32(out[16:], uint32(codeLen))\n\tbinary.LittleEndian.PutUint32(out[20:], uint32(hdrLen+codeLen))\n\tbinary.LittleEndian.PutUint32(out[24:], uint32(len(p.data)))\n\tfor i, in := range p.text {\n\t\to := hdrLen + i*16\n\t\tout[o] = in.op\n\t\tout[o+1] = in.dst\n\t\tout[o+2] = in.src\n\t\tout[o+3] = in.aux\n\t\tbinary.LittleEndian.PutUint64(out[o+8:], in.imm)\n\t}\n\tcopy(out[hdrLen+codeLen:], p.data)\n\treturn out\n}","lineStart":1,"lineEnd":384,"totalLines":384,"truncated":false}},"title":"home/cyr/kernel/tools/vasm/main.go","time":{"start":1787342938884,"end":1787342938901}},"id":"prt_025f0e2fc001INwkZ2qn7irCKN","sessionID":"ses_fda1daed3ffeZ76o2z0rrfeMgg","messageID":"msg_025effce7001xdy1MtESijne3P"}}

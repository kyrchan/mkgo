fsreq[23] = (uint8_t)(plen >> 8);\n    uint32_t o = 24;\n    for (uint32_t i = 0; i < plen && o < sizeof(fsreq); i++)\n        fsreq[o++] = (uint8_t)path[i];\n    for (uint32_t i = 0; i < paylen && o < sizeof(fsreq); i++)\n        fsreq[o++] = payload[i];\n    return o;\n}'''\nassert old in s; s=s.replace(old,new)\nopen(p,'w').write(s)\n\n# ---- fs.wasm Go: new framing parse ----\np='services/fs/main.go'; s=open(p).read()\nold='''func handleReq(req []byte) []byte {\n\tif len(req) < 10 {\n\t\treturn errnoReply(52)\n\t}\n\top := g16(req, 0)\n\tuid := g32(req, 4)\n\tplen := g16(req, 8)\n\tif 10+plen > len(req) {\n\t\treturn errnoReply(52)\n\t}\n\tpath := rooted(uid, string(req[10:10+plen]))\n\tpayload := req[10+plen:]'''\nnew='''var replyHandles = map[string]int32{}\n\nfunc replyTo(rname string, resp []byte) {\n\tif rname == \"\" {\n\t\treturn // synchronous caller\n\t}\n\th, ok := replyHandles[rname]\n\tif !ok {\n\t\th = port_bind(&cstr(rname)[0], uint32(len(rname)))\n\t\tif h < 0 {\n\t\t\treturn\n\t\t}\n\t\treplyHandles[rname] = h\n\t}\n\tport_send(h, &resp[0], uint32(len(resp)))\n}\n\n// framing: {u16 op,u16 seq,u32 uid,char rname[16],u16 path_len,path,payload}\nfunc handleReq(req []byte) []byte {\n\tif len(req) < 24 {\n\t\treturn errnoReply(52)\n\t}\n\top := g16(req, 0)\n\tuid := g32(req, 4)\n\trname := cstrz(req[6:22])\n\tplen := g16(req, 22)\n\tif 24+plen > len(req) {\n\t\treturn errnoReply(52)\n\t}\n\tpath := rooted(uint32(uid), string(req[24:24+plen]))\n\tpayload := req[24+plen:]\n\t_ = rname'''\nassert old in s; s=s.replace(old,new)\n# route replies through replyTo at the END of handleReq instead of returning raw\ns=s.replace('''\tswitch op {''','''\tresp := dispatch(op, uid, path, payload)\n\treplyTo(rname, resp)\n\treturn resp\n}\n\nfunc dispatch(op int, uid int, path string, payload []byte) []byte {\n\tswitch op {''')\nopen(p,'w').write(s)\nprint('ok')\nPYEOF\ncd services/fs && GOOS=wasip1 GOARCH=wasm go build -o fs.wasm.raw main.go 2>&1 | head -5","timeout
te, write bool) bool {\n\tif int(count)*Sect > stageCap || int(count)*Sect > len(data) && write {\n\t\treturn false\n\t}\n\tstaging := unsafe.Pointer(winBase + stageOff)\n\tif write {\n\t\tfor i := 0; i < int(count)*Sect; i++ {\n\t\t\t*(*byte)(unsafe.Add(staging, i)) = data[i]\n\t\t}\n\t}\n\tif !blkIO(op, lba, count) {\n\t\treturn false\n\t}\n\tif !write {\n\t\tfor i := 0; i < int(count)*Sect; i++ {\n\t\t\tdata[i] = *(*byte)(unsafe.Add(staging, i))\n\t\t}\n\t}\n\treturn true\n}\n\nfunc wrSectors(lba uint64, src []byte) {\n\tn := uint32(len(src) / Sect)\n\tfor done := uint32(0); done < n; {\n\t\tchunk := n - done\n\t\tif chunk > stageCap/Sect {\n\t\t\tchunk = stageCap / Sect\n\t\t}\n\t\toff := int(done) * Sect\n\t\tif !blkIOBulk(2, lba+uint64(done), chunk, src[off:off+int(chunk)*Sect], true) {\n\t\t\tpanic(\"blk bulk write\")\n\t\t}\n\t\tdone += chunk\n\t}\n}\n\nfunc rdSectors(lba uint64, dst []byte) {\n\tn := uint32(len(dst) / Sect)\n\tfor done := uint32(0); done < n; {\n\t\tchunk := n - done\n\t\tif chunk > stageCap/Sect {\n\t\t\tchunk = stageCap / Sect\n\t\t}\n\t\toff := int(done) * Sect\n\t\tif !blkIOBulk(1, lba+uint64(done), chunk, dst[off:off+int(chunk)*Sect], false) {\n\t\t\tpanic(\"blk bulk read\")\n\t\t}\n\t\tdone += chunk\n\t}\n}\n\nfunc wrSector(lba uint64, src []byte) {''')\n\n# fast format using bulk writes\nold='''func fmtDisk() {\n\tzeros := make([]byte, Sect)\n\tfor lba := 0; lba < totSec; lba++ {\n\t\twrSector(uint64(lba), zeros)\n\t}'''\nnew='''func fmtDisk() {\n\tzeros := make([]byte, 128*Sect) // 64 KiB bulk chunks\n\tfor lba := 0; lba < totSec; lba += 128 {\n\t\twrSectors(uint64(lba), zeros)\n\t}'''\nassert old in s; s=s.replace(old,new)\n\n# loadDir/saveRoot/saveDirChain bulk reads/writes\ns=s.replace('''\tif firstClus == 0 { // root\n\t\tout := make([]byte, rootSecs*Sect)\n\t\tfor i := 0; i < rootSecs; i++ {\n\t\t\trdSector(uint64(firstRoot+i), out[i*Sect:(i+1)*Sect])\n\t\t}\n\t\treturn out\n\t}\n\tvar out []byte\n\tfor c := firstClus; c > 0; c
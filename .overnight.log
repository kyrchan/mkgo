{"type":"tool_use","timestamp":1787383331235,"sessionID":"ses_fda1daed3ffeZ76o2z0rrfeMgg","part":{"type":"tool","tool":"write","callID":"call_3625c6b7beab438a99cd7cb5","state":{"status":"completed","input":{"content":"// login.wasm -- well-known \"login\" service (Phase 5 multiuser stub).\n// Static user table (v1); validates credentials arriving as framed\n// datagrams and grants identity+capability sets via registry LOGIN op.\n// Only the owner of \"login\" may call LOGIN -- kernel-enforced (ABI v1.1).\npackage main\n\nimport (\n\t\"os\"\n)\n\n//go:wasmimport wasi_snapshot_preview1 sched_yield\nfunc sched_yield() int32\n\n//go:wasmimport kernel kern_port_create\nfunc port_create(name *byte, nameLen uint32) int32\n\n//go:wasmimport kernel kern_port_bind\nfunc port_bind(name *byte, nameLen uint32) int32\n\n//go:wasmimport kernel kern_port_send\nfunc port_send(h int32, buf *byte, len uint32) int32\n\n//go:wasmimport kernel kern_port_recv\nfunc port_recv(h int32, buf *byte, cap uint32) int32\n\ntype user struct {\n\tname string\n\tpw   string\n\tuid  uint32\n\tcaps uint32\n}\n\nvar users = []user{\n\t{\"admin\", \"admin\", 0, 0x7F},\n\t{\"u1\", \"u1\", 1, 0},\n\t{\"u2\", \"u2\", 2, 0},\n}\n\nfunc cstr(s string) []byte {\n\tb := make([]byte, len(s)+1)\n\tcopy(b, s)\n\treturn b\n}\n\n/* client request: {u16 op=1, char user[16], char pw[16]} */\nfunc handleAuth(req []byte) []byte {\n\tif len(req) < 34 {\n\t\treturn []byte{0xFF, 0xFF} // errno -1\n\t}\n\tun := cstrz(req[2:18])\n\tpw := cstrz(req[18:34])\n\tfor _, u := range users {\n\t\tif u.name == un && u.pw == pw {\n\t\t\t// grant via registry LOGIN {name[16], uid, capmask}\n\t\t\tif doLogin(u.name, u.uid, u.caps) {\n\t\t\t\tos.Stdout.WriteString(\"[login] '\")\n\t\t\t\tos.Stdout.WriteString(un)\n\t\t\t\tos.Stdout.WriteString(\"' authenticated -> uid=\")\n\t\t\t\tos.Stdout.WriteString(itoa(int(u.uid)))\n\t\t\t\tos.Stdout.WriteString(\"\\n\")\n\t\t\t\treturn []byte{0, 0}\n\t\t\t}\n\t\t\treturn []byte{0xFE, 0xFF} // registry refused\n\t\t}\n\t}\n\tos.Stdout.WriteString(\"[login] auth denied for '\")\n\tos.Stdout.WriteString(un)\n\tos.Stdout.WriteString(\"'\\n\")\n\treturn []byte{0x10, 0x00} // EACCES-ish custom code 16\n}\n\nfunc cstrz(b []byte) string {\n\tend := 0\n\tfor end < len(b) && b[end] != 0 {\n\t\tend++\n\t}\n\treturn string(b[:end])\n}\n\nfunc doLogin(name string, uid, caps uint32) bool {\n\trg := port_bind(&cstr(\"registry\")[0], 8)\n\tif rg < 0 {\n\t\treturn false\n\t}\n\treq := make([]byte, 4+24)\n\treq[0] = 5 // LOGIN\n\treq[3] = 7 // seq\n\tcopy(req[4:20], name)\n\treq[20] = byte(uid)\n\treq[21] = byte(uid >> 8)\n\treq[22] = byte(uid >> 16)\n\treq[23] = byte(uid >> 24)\n\treq[24] = byte(caps)\n\treq[25] = byte(caps >> 8)\n\treq[26] = byte(caps >> 16)\n\treq[27] = byte(caps >> 24)\n\tport_send(rg, &req[0], uint32(len(req)))\n\tout := make([]byte, 64)\n\tfor i := 0; i < 10000; i++ {\n\t\tn := port_recv(rg, &out[0], uint32(len(out)))\n\t\tif n >= 8 && out[2] == 7 {\n\t\t\tst := uint32(out[4]) | uint32(out[5])<<8 |\n\t\t\t\tuint32(out[6])<<16 | uint32(out[7])<<24\n\t\t\treturn st == 0\n\t\t}\n\t\tsched_yield()\n\t}\n\treturn false\n}\n\nfunc itoa(v int) string {\n\tif v == 0 {\n\t\treturn \"0\"\n\t}\n\tvar b [20]byte\n\ti := len(b)\n\tfor v > 0 {\n\t\ti--\n\t\tb[i] = byte('0' + v%10)\n\t\tv /= 10\n\t}\n\treturn string(b[i:])\n}\n\nfunc main() {\n\tos.Stdout.WriteString(\"[login] ready\\n\")\n\th := port_create(&cstr(\"login\")[0], 5)\n\tbuf := make([]byte, 512)\n\tfor {\n\t\tif h >= 0 {\n\t\t\tn := port_recv(h, &buf[0], uint32(len(buf)))\n\t\t\tif n > 0 {\n\t\t\t\tresp := handleAuth(buf[:n])\n\t\t\t\tport_send(h, &resp[0], uint32(len(resp)))\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tsched_yield()\n\t}\n}\n","filePath":"/home/cyr/kernel/services/login/main.go"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/cyr/kernel/services/login/main.go","exists":true,"truncated":false},"title":"services/login/main.go","time":{"start":1787383331197,"end":1787383331231}},"id":"prt_028593972001KCyxGmS1R27lFu","sessionID":"ses_fda1daed3ffeZ76o2z0rrfeMgg","messageID":"msg_02858d545001H1xJPsL0em89xb"}}

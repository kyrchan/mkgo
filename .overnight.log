nt8_t wsel, uint64_t *out) {\n49:     if (ea + width_bytes(wsel) > vm->mem_len)\n50:         return -1;\n51:     uint64_t v = 0;\n52:     for (uint64_t i = 0; i < width_bytes(wsel); i++)\n53:         v |= (uint64_t)vm->mem[ea + i] << (8 * i);\n54:     *out = v;\n55:     return 0;\n56: }\n57: \n58: /* returns 1 when the store hit the console window */\n59: static int guest_store(struct vm *vm, uint64_t ea, uint8_t wsel, uint64_t val) {\n60:     if (ea + width_bytes(wsel) > vm->mem_len)\n61:         return -1;\n62:     if (ea == VM_CONSOLE_OFF) {\n63:         serial_puts(\"[vm] out \");\n64:         serial_hex64(val);\n65:         serial_puts(\"\\n\");\n66:         return 1;\n67:     }\n68:     if (ea == VM_CONSOLE_OFF + 8) {\n69:         serial_putc((char)(val & 0xFF));\n70:         return 1;\n71:     }\n72:     for (uint64_t i = 0; i < width_bytes(wsel); i++)\n73:         vm->mem[ea + i] = (uint8_t)(val >> (8 * i));\n74:     return 0;\n75: }\n76: \n77: void vec_load(void *p, void *dst);\n78: void vec_store(void *p, const void *src);\n79: void vec_bcast(uint64_t val, int szcls, void *dst);\n80: void vec_sub(const void *a, const void *b, int szcls, void *dst);\n81: int vec_cmpeq_all(const void *a, const void *b, int szcls, void *dst);\n82: \n83: int vm_run(struct vm *vm) {\n84:     static const void *disp[256] = {\n85:         [0 ... 255] = &&illegal,\n86:         [OP_MOV] = &&L_mov,           [OP_LEA] = &&L_lea,\n87:         [OP_SUB] = &&L_sub,           [OP_JZ] = &&L_jz,\n88:         [OP_VMOVDQU] = &&L_vmovdqu,   [OP_VPBROADCAST] = &&L_vpbcast,\n89:         [OP_VPSUB] = &&L_vsub,        [OP_VPCMPEQ] = &&L_vcmpeq,\n90:         [OP_HALT] = &&L_halt,\n91:     };\n92: #define STEP() (vm->pc += sizeof(struct insn))\n93:     const struct insn *code = (const struct insn *)vm->code;\n94: \n95:     goto *disp[code[vm->pc / 16].op];\n96: \n97: L_mov: {\n98:     const struct insn *in = &code[vm->pc / 16];\n99:     uint8_t mode = in->aux & 7;\n100:     switch (mode) {\n101:    
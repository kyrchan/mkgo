(s string) {\n\tif consoleH >= 0 {\n\t\tlib.SendOrBlock(consoleH, []byte(s))\n\t} else {\n\t\tlib.ConsoleOut(s)\n\t}\n}''','''var consoleDead bool\n\nfunc out(s string) {\n\toutBytes([]byte(s))\n}\n\nfunc outBytes(b []byte) {\n\tif consoleDead || consoleH < 0 {\n\t\tlib.ConsoleOutBytes(b)\n\t\treturn\n\t}\n\tfor i := 0; i < 200000; i++ {\n\t\trc := lib.SendOrBlock(consoleH, b)\n\t\t_ = rc\n\t\treturn\n\t}\n\tconsoleDead = true\n\tlib.ConsoleOutBytes(b)\n}''')\ns=s.replace('''\t\tif consoleH >= 0 {\n\t\t\tlib.SendOrBlock(consoleH, data)\n\t\t\tif len(data) == 0 || data[len(data)-1] != '\\\\n' {\n\t\t\t\tlib.SendOrBlock(consoleH, []byte(\"\\\\n\"))\n\t\t\t}\n\t\t} else {\n\t\t\tos.Stdout.Write(data)\n\t\t}''','''\t\toutBytes(data)\n\t\tif len(data) == 0 || data[len(data)-1] != '\\\\n' {\n\t\t\toutBytes([]byte(\"\\\\n\"))\n\t\t}''')\nopen(p,'w').write(s)\nprint('ok')\nPYEOF\ncd /home/cyr/kernel/services && GOOS=wasip1 GOARCH=wasm go build -o fs/fs.wasm.raw ./fs && GOOS=wasip1 GOARCH=wasm go build -o shell/shell.wasm.raw ./shell 2>&1 | head -4; python3 /home/cyr/kernel/scripts/add_abiver.py fs/fs.wasm.raw fs/fs.wasm 1 >/dev/null; python3 /home/cyr/kernel/scripts/add_abiver.py shell/shell.wasm.raw shell/shell.wasm 1 >/dev/null; echo STAMPED","timeout":180000},"output":"ok\nmain module (kernel.services) does not contain package kernel.services/fs\nSTAMPED\n","metadata":{"output":"ok\nmain module (kernel.services) does not contain package kernel.services/fs\nSTAMPED\n","exit":0,"truncated":false},"title":"python3 <<'PYEOF'\n# 1) fs: /etc world-readable, admin-writable\np='/home/cyr/kernel/services/fs/fscore.go'; s=open(p).read()\ns=s.replace('''func rooted(uid uint32, p string) string {\n\tr := rootFor(uid)\n\tfor len(p) > 0 && p[0] == '/' {\n\t\tp = p[1:]\n\t}\n\treturn r + p\n}''','''func rooted(uid uint32, p string) string {\n\tfor len(p) > 0 && p[0] == '/' {\n\t\tp = p[1:]\n\t}\n\t// /etc is world-readable (ABI v1: readable by all, admin-write only)\n\tif p == \"etc\" 
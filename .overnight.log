          break;\n        }\n        console_puts(\"[audit] sid=\");'''\nassert old in s; s=s.replace(old,new)\nopen(p,'w').write(s)\n\n# sched.h already declares sched_is_login/set_identity/by_name ✓\nprint('ok')\nPYEOF","time":{"start":1787383305189,"end":1787383305225}},"id":"prt_02858d38f001UsLuYqhscCovFj","sessionID":"ses_fda1daed3ffeZ76o2z0rrfeMgg","messageID":"msg_0285873e90014L60vFmsrSETid"}}

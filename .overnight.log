e(SB), AX\n60: \\tRET\n61: \"\"\")\n62: \n63:     print(\"\".join(out), end=\"\")\n64: \n65: \n66: if __name__ == \"__main__\":\n67:     main()\n\n(End of file - total 67 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"Generate Plan 9 assembly for the 256 IDT stubs + dispatch table.\"\"\"\n\nHEADER = '''#include \"textflag.h\"\n\n// Code generated by scripts/gen_vectors.py. DO NOT EDIT.\n//\n// Uniform exception frame passed to isr_dump():\n//   0(SP)  vector, 8(SP) error code (real or dummy), 16(SP) rip ...\n\n'''\n\nSTUB_NOERR = \"\"\"TEXT isr_{v}(SB), NOSPLIT, $-8\n\\tPUSHQ $0\n\\tPUSHQ ${v}\n\\tJMP common<>(SB)\n\n\"\"\"\n\nSTUB_ERR = \"\"\"TEXT isr_{v}(SB), NOSPLIT, $-8","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/cyr/kernel/scripts/gen_vectors.py","text":"#!/usr/bin/env python3\n\"\"\"Generate Plan 9 assembly for the 256 IDT stubs + dispatch table.\"\"\"\n\nHEADER = '''#include \"textflag.h\"\n\n// Code generated by scripts/gen_vectors.py. DO NOT EDIT.\n//\n// Uniform exception frame passed to isr_dump():\n//   0(SP)  vector, 8(SP) error code (real or dummy), 16(SP) rip ...\n\n'''\n\nSTUB_NOERR = \"\"\"TEXT isr_{v}(SB), NOSPLIT, $-8\n\\tPUSHQ $0\n\\tPUSHQ ${v}\n\\tJMP common<>(SB)\n\n\"\"\"\n\nSTUB_ERR = \"\"\"TEXT isr_{v}(SB), NOSPLIT, $-8\n\\tPUSHQ ${v}\n\\tJMP common<>(SB)\n\n\"\"\"\n\nERRCODED = {8, 10, 11, 12, 13, 14, 17}\n\n\ndef main():\n    out = [HEADER]\n    for v in range(256):\n        t = STUB_ERR if v in ERRCODED else STUB_NOERR\n        out.append(t.format(v=v))\n\n    out.append(\"\"\"TEXT common<>(SB), NOSPLIT, $-8\n\\tCLD\n\\tCLI\n\\tMOVQ SP, DI\n\\tMOVQ isr_dump_ptr(SB), AX\n\\tCALL (AX)\nloop:\n\\tHLT\n\\tJMP loop\n\n// set by gdt_idt.c before lidt\nGLOBL isr_dump_ptr(SB), NOPTR, $8\nDATA isr_dump_ptr+0(SB)/8, $0\n\n// void *isr_stub_table[256]\nGLOBL isr_stub_table(SB), NOPTR|RODATA, $2048\n\"\"\")\n    for v in range(256):\n        out.append(f\"DATA isr_stub_table+{v*8}(SB)/8, $isr_{v}(SB)\\n\")\n\n    # Assembly-implemented accessor referenced from shim.go's package\n    # initializer — this is what keeps the stub bank alive in the archive.\n    out.append(\"\"\"\nTEXT ·stubTablePtr(SB), NOSPLIT, $-8\n\\tMOVQ $isr_stub_table(SB), AX\n\\tRET\n\"\"\")\n\n    print(\"\".join(out), end=\"\")\n\n\nif __name__ == \"__main__\":\n    main()","lineStart":1,"lineEnd":67,"totalLines":67,"truncated":false}},"title":"scripts/gen_vectors.py","time":{"start":1787343790973,"end":1787343791026}},"id":"prt_025fde376001OefPUFBzsSUTUQ","sessionID":"ses_fda1daed3ffeZ76o2z0rrfeMgg","messageID":"msg_025fdc8d0001Yx422RzbTeofAD"}}

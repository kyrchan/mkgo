     sessions[sid].uid = uid;\n        sessions[sid].capmask = capmask;\n        console_puts(\"[sched] identity '\");\n        console_puts(sessions[sid].name);\n        console_puts(\"' uid=\");\n        console_hex64(uid);\n        console_puts(\" caps=\");\n        console_hex64(capmask);\n        console_puts(\"\\\\n\");\n    }\n}\n\nextern \"C\" bool ports_name_owned_by(uint32_t sid, const char *name);\nbool sched_is_login(uint32_t sid) {\n    return ports_name_owned_by(sid, \"login\");\n}\n\nint sched_kill(uint32_t sid) {''')\nopen(p,'w').write(s)\nprint('ok')\nPYEOF","workdir":"/home/cyr/kernel"},"output":"ok\n","metadata":{"output":"ok\n","exit":0,"truncated":false},"title":"python3 <<'PYEOF'\n# per-session fd table + name lookup in sched\np='core/sched.h'; s=open(p).read()\ns=s.replace('''/* per-session WASI state (args, exit) so concurrent sessions don't share */\nstruct sched_wasi_state {\n    const char *argv[16];\n    bool exited;\n    int exit_code;\n};''','''/* per-session WASI state (args, exit, routed-fd table) */\n#define SCHED_MAX_FDS 64\n#define SCHED_FD_EMPTY 0xFFFFFFFFu\nstruct sched_wasi_state {\n    const char *argv[16];\n    bool exited;\n    int exit_code;\n    uint32_t fds[SCHED_MAX_FDS]; /* fd -> fs file handle (SCHED_FD_EMPTY) */};''')\ns=s.replace('''void sched_preload_image(const char *name, const uint8_t *blob, uint64_t len);\n\n#endif''','''void sched_preload_image(const char *name, const uint8_t *blob, uint64_t len);\nint  sched_session_by_name(const char *name); /* sid | -1 */\nvoid sched_set_identity(uint32_t sid, uint32_t uid, uint64_t capmask);\nbool sched_is_login(uint32_t sid); /* does sid own the \"login\" port? */\n\n#endif''')\nopen(p,'w').write(s)\n\np='core/sched.cc'; s=open(p).read()\ns=s.replace('''        s->wctx.exited = false;\n        s->wctx.exit_code = 0;''','''        s->wctx.exited = false;\n        s->wctx.exit_code = 0;\n        for (int k = 0; k < SCHED_MAX_FDS; k++)\n            s->wctx.fds[k] = SCHED_FD_EMPTY;''')\ns=s.replace('''int sched_kill(uint32_t sid) {''','''int sched_session_by_name(const char *name) {\n    for (int i = 1; i < MAX_SESSIONS; i++) {\n        if ((sessions[i].state == S_RUNNABLE || sessions[i].state == S_RUNNING) &&\n            !strcmp(sessions[i].name, name))\n            return i;\n    }\n    return -1;\n}\n\nvoid sched_set_identity(uint32_t sid, uint32_t uid, uint64_t capmask) {\n    if (sid < MAX_SESSIONS && sessions[sid].state != S_FREE) {\n        sessions[sid].uid = uid;\n        sessions[sid].capmask = capmask;\n        console_puts(\"[sched] identity '\");\n        console_puts(sessions[sid].name);\n        console_puts(\"' uid=\");\n        console_hex64(uid);\n        console_puts(\" caps=\");\n        console_hex64(capmask);\n        console_puts(\"\\\\n\");\n    }\n}\n\nextern \"C\" bool ports_name_owned_by(uint32_t sid, const char *name);\nbool sched_is_login(uint32_t sid) {\n    return ports_name_owned_by(sid, \"login\");\n}\n\nint sched_kill(uint32_t sid) {''')\nopen(p,'w').write(s)\nprint('ok')\nPYEOF","time":{"start":1787382123109,"end":1787382123115}},"id":"prt_02846ca35001IKCZSI5Now6QUp","sessionID":"ses_fda1daed3ffeZ76o2z0rrfeMgg","messageID":"msg_028465983001A3hO7N7RaunsZ2"}}

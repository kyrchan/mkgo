{"type":"step_start","timestamp":1787405835563,"sessionID":"ses_fda1daed3ffeZ76o2z0rrfeMgg","part":{"id":"prt_029b09d03001C05AX967JWJ6ep","messageID":"msg_029b01d92001XH6rPsJBRxr1pf","sessionID":"ses_fda1daed3ffeZ76o2z0rrfeMgg","snapshot":"193095177594cfc17f4a6948ac51eed95e38d41e","type":"step-start"}}
{"type":"tool_use","timestamp":1787405835581,"sessionID":"ses_fda1daed3ffeZ76o2z0rrfeMgg","part":{"type":"tool","tool":"write","callID":"call_ffb632b6a2704055aea323e2","state":{"status":"completed","input":{"content":"/* Input subsystem (abi/ABI.md §4): serial bytes become key-down records\n * delivered ONLY to the focused session. Focus is a kernel attribute\n * moved via kern_focus_set(port_handle) by FOCUS-capable sessions. */\n#include \"input.h\"\n#include \"plat.h\"\n#include \"sched.h\"\n\n#define QLEN 256\n\nstatic struct {\n    uint8_t kind[QLEN];\n    uint8_t mods[QLEN];\n    uint16_t cp[QLEN];\n    int qh, qt, qn;\n} inq;\n\nstatic int32_t focus_sid = -1;\n\nvoid input_init(void) {\n    inq.qh = inq.qt = inq.qn = 0;\n    focus_sid = -1;\n}\n\n/* map a console byte to an input record */\nstatic void push_byte(uint8_t b) {\n    if (inq.qn >= QLEN)\n        return; /* drop when full */\n    uint16_t cp = b;\n    if (b == '\\r')\n        cp = '\\n';\n    inq.kind[inq.qt] = 1; /* key_down */\n    inq.mods[inq.qt] = 0;\n    inq.cp[inq.qt] = cp;\n    inq.qt = (inq.qt + 1) % QLEN;\n    inq.qn++;\n}\n\nvoid input_poll(void) {\n    for (int n = 0; n < 64 && console_rx_ready(); n++) {\n        push_byte((uint8_t)console_rx_byte());\n    }\n}\n\nint input_recv(uint32_t sid, void *out, uint32_t cap) {\n    if (!out || cap < 4)\n        return 0;\n    if ((int32_t)sid != focus_sid)\n        return 0; /* only the focused session receives */\n    uint32_t maxrec = cap / 4;\n    uint32_t copied = 0;\n    uint8_t *dst = (uint8_t *)out;\n    while (inq.qn > 0 && copied < maxrec) {\n        dst[copied * 4 + 0] = inq.kind[inq.qh];\n        dst[copied * 4 + 1] = inq.mods[inq.qh];\n        dst[copied * 4 + 2] = (uint8_t)inq.cp[inq.qh];\n        dst[copied * 4 + 3] = (uint8_t)(inq.cp[inq.qh] >> 8);\n        inq.qh = (inq.qh + 1) % QLEN;\n        inq.qn--;\n        copied++;\n    }\n    return (int)(copied * 4);\n}\n\nint input_focus_set(uint32_t caller_sid, int handle) {\n    if (!(sched_capmask_of(caller_sid) & SCHED_CAP_FOCUS))\n        return -1;\n    extern \"C\" int ports_owner_of_handle(uint32_t sid, int h);\n    int owner = ports_owner_of_handle(caller_sid, handle);\n    if (owner <= 0)\n        return -1;\n    focus_sid = owner;\n    console_puts(\"[input] focus -> '\");\n    console_puts(sched_name_of((uint32_t)owner));\n    console_puts(\"'\\n\");\n    return 0;\n}\n","filePath":"/home/cyr/kernel/core/input.cc"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/cyr/kernel/core/input.cc","exists":false,"truncated":false},"title":"core/input.cc","time":{"start":1787405835555,"end":1787405835574}},"id":"prt_029b09d14001mh7MdyAN8H6H7r","sessionID":"ses_fda1daed3ffeZ76o2z0rrfeMgg","messageID":"msg_029b01d92001XH6rPsJBRxr1pf"}}
